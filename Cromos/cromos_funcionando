// PANTALLA 2: PANEL DE USUARIO (GRILLA PEQUEÑA OPTIMIZADA)
// ════════════════════════════════════════════════════════════════
class UserPanelScreen extends StatefulWidget {
  const UserPanelScreen({super.key});
  @override State<UserPanelScreen> createState() => _UserPanelScreenState();
}
class _UserPanelScreenState extends State<UserPanelScreen> {
  bool _bloqueado = false;

  Future<void> _abrirSobreMisterioso(String sobreId, Map<String, dynamic> sData) async {
    if (_bloqueado) return;
    setState(() => _bloqueado = true);
    
    final db = FirebaseFirestore.instance;
    final sobreRef = db.collection('sobres_items').doc(sobreId);

    try {
      final contenido = await db.runTransaction((tx) async {
        final sDoc = await tx.get(sobreRef);
        if (!sDoc.exists) throw "Este sobre ya no existe.";
        
        final data = sDoc.data()!;
        if (data['abierto'] == true) throw "Este sobre ya fue abierto.";
        if (data['asignado_a'] != sesionActual!.nombre) throw "Este sobre no está asignado a ti.";

        tx.update(sobreRef, {
          'abierto': true,
          'fecha_abierto': FieldValue.serverTimestamp(),
        });

        return List<String>.from(data['contenido'] ?? []);
      });

      if (mounted) {
        await Navigator.push(context, PageRouteBuilder(
          opaque: false,
          transitionDuration: const Duration(milliseconds: 300),
          pageBuilder: (context, _, __) => EfectoAperturaPro(cromos: contenido, nombreSobre: sData['alias'] ?? 'Sobre'),
          transitionsBuilder: (context, anim, _, child) => FadeTransition(opacity: anim, child: child),
        ));
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(e.toString()), backgroundColor: Colors.redAccent));
      }
    } finally {
      if (mounted) setState(() => _bloqueado = false);
    }
  }

  // OPTIMIZACIÓN: Método súper rápido para obtener el número de sobre
  int _getNumeroSobre(Map<String, dynamic> data) {
    if (data['numero'] != null) return data['numero'] as int;
    final alias = data['alias']?.toString() ?? '';
    final partes = alias.split(' ');
    if (partes.isNotEmpty) return int.tryParse(partes.last) ?? 999;
    return 999;
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text("HOLA, ${sesionActual!.nombre}", style: const TextStyle(color: turquesaTema, fontWeight: FontWeight.w900, fontSize: 16)),
        actions: [
          IconButton(
            icon: const Icon(Icons.refresh, color: verdeNeon), 
            tooltip: "Refrescar",
            onPressed: () => setState(() {})
          ),
          IconButton(icon: const Icon(Icons.exit_to_app, color: Colors.redAccent), onPressed: () => Navigator.pushReplacement(context, MaterialPageRoute(builder: (_) => const LoginScreen())))
        ],
      ),
      body: Column(children: [
        Container(
          width: double.infinity, padding: const EdgeInsets.symmetric(horizontal: 15, vertical: 10), 
          color: turquesaTema.withValues(alpha: 0.1),
          child: const Text("TOCA UN SOBRE PARA ABRIRLO", style: TextStyle(color: turquesaTema, fontWeight: FontWeight.bold, fontSize: 12, letterSpacing: 1), textAlign: TextAlign.center),
        ),
        Expanded(
          child: StreamBuilder<QuerySnapshot>(
            stream: FirebaseFirestore.instance.collection('sobres_items')
                .where('asignado_a', isEqualTo: sesionActual!.nombre)
                .snapshots(),
            builder: (context, snapshot) {
              if (!snapshot.hasData) return const Center(child: CircularProgressIndicator(color: turquesaTema));
              final sobres = snapshot.data!.docs;
              
              if (sobres.isEmpty) return const Center(child: Text("No tienes sobres asignados.", style: TextStyle(color: Colors.white54, fontSize: 16)));

              // ORDENAMIENTO OPTIMIZADO (Sin Expresiones Regulares Lentas)
              sobres.sort((a, b) {
                 final dataA = a.data() as Map<String, dynamic>;
                 final dataB = b.data() as Map<String, dynamic>;
                 final abA = dataA['abierto'] == true ? 1 : 0;
                 final abB = dataB['abierto'] == true ? 1 : 0;
                 if (abA != abB) return abA.compareTo(abB);
                 return _getNumeroSobre(dataA).compareTo(_getNumeroSobre(dataB));
              });

              return GridView.builder(
                padding: const EdgeInsets.all(10),
                gridDelegate: const SliverGridDelegateWithMaxCrossAxisExtent(
                  maxCrossAxisExtent: 110, // Compacto para que se vean bastantes
                  crossAxisSpacing: 10, 
                  mainAxisSpacing: 10, 
                  childAspectRatio: 0.75 // Ajustado para que el texto de los cromos entre mejor
                ),
                itemCount: sobres.length,
                itemBuilder: (context, i) {
                  final s = sobres[i];
                  final sData = s.data() as Map<String, dynamic>;
                  final bool abierto = sData['abierto'] ?? false;
                  final List<String> cont = List<String>.from(sData['contenido'] ?? []);

                  if (abierto) {
                    return Container(
                      decoration: BoxDecoration(
                        color: Colors.black26, borderRadius: BorderRadius.circular(10),
                        border: Border.all(color: Colors.white12, width: 1),
                      ),
                      child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
                        const SizedBox(height: 5),
                        const Icon(Icons.drafts, color: Colors.white24, size: 24),
                        Text(sData['alias'] ?? 'Sobre', style: const TextStyle(color: Colors.white38, fontWeight: FontWeight.bold, fontSize: 11), textAlign: TextAlign.center, maxLines: 1),
                        const Text("ABIERTO", style: TextStyle(color: Colors.redAccent, fontSize: 9, fontWeight: FontWeight.w900)),
                        const SizedBox(height: 4),
                        // MOSTRAR CONTENIDO DIRECTAMENTE AQUÍ (Sin Toca para ver)
                        Expanded(
                          child: SingleChildScrollView(
                            child: Padding(
                              padding: const EdgeInsets.symmetric(horizontal: 4),
                              child: Text(cont.join('\n'), style: const TextStyle(color: turquesaTema, fontSize: 10, fontWeight: FontWeight.bold), textAlign: TextAlign.center),
                            ),
                          ),
                        )
                      ]),
                    );
                  }

                  return GestureDetector(
                    onTap: _bloqueado ? null : () => _abrirSobreMisterioso(s.id, sData),
                    child: Container(
                      decoration: BoxDecoration(
                        gradient: LinearGradient(
                          begin: Alignment.topLeft, end: Alignment.bottomRight,
                          colors: [naranjaTema.withValues(alpha: 0.9), Colors.deepPurpleAccent.withValues(alpha: 0.9)]
                        ),
                        borderRadius: BorderRadius.circular(10),
                        border: Border.all(color: Colors.amber, width: 1.5),
                      ),
                      child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
                        const Icon(Icons.mark_email_unread, color: Colors.white, size: 35),
                        const SizedBox(height: 6),
                        Text(sData['alias'] ?? 'Sobre', style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w900, fontSize: 12), textAlign: TextAlign.center, maxLines: 1, overflow: TextOverflow.ellipsis),
                      ]),
                    ),
                  );
                },
              );
            }
          ),
        )
      ]),
    );
  }
}

