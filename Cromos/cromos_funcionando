// EFECTO PRO DE APERTURA (FULL SCREEN - RÁPIDO)
// ════════════════════════════════════════════════════════════════
class EfectoAperturaPro extends StatefulWidget {
  final List<String> cromos;
  final String nombreSobre;
  const EfectoAperturaPro({super.key, required this.cromos, required this.nombreSobre});

  @override
  State<EfectoAperturaPro> createState() => _EfectoAperturaProState();
}

class _EfectoAperturaProState extends State<EfectoAperturaPro> with TickerProviderStateMixin {
  int _fase = 0; 
  
  @override
  void initState() {
    super.initState();
    _iniciarSecuencia();
  }

  void _iniciarSecuencia() async {
    await Future.delayed(const Duration(milliseconds: 100));
    if(mounted) setState(() => _fase = 1); 
    await Future.delayed(const Duration(milliseconds: 600));
    if(mounted) setState(() => _fase = 2); 
    await Future.delayed(const Duration(milliseconds: 100));
    if(mounted) setState(() => _fase = 3); 
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: _fase == 2 ? Colors.white : Colors.black.withValues(alpha: 0.95),
      body: Center(child: _construirFase()),
    );
  }

  Widget _construirFase() {
    if (_fase < 2) {
      return TweenAnimationBuilder<double>(
        key: const ValueKey('sobre'),
        tween: Tween(begin: 1.0, end: _fase == 1 ? 1.5 : 1.0),
        duration: const Duration(milliseconds: 600),
        curve: Curves.elasticOut,
        builder: (context, scale, child) {
          return Transform.scale(
            scale: scale,
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Icon(Icons.mark_email_unread, color: Colors.amber, size: 120),
                const SizedBox(height: 20),
                Text(widget.nombreSobre, style: const TextStyle(color: Colors.amber, fontWeight: FontWeight.w900, fontSize: 24)),
              ],
            ),
          );
        },
      );
    } else if (_fase == 2) {
      return Container(key: const ValueKey('flash'), color: Colors.white);
    } else {
      return Column(
        key: const ValueKey('cartas'),
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          const Text("¡CONSEGUISTE!", style: TextStyle(color: verdeNeon, fontSize: 30, fontWeight: FontWeight.w900, letterSpacing: 3)),
          const SizedBox(height: 30),
          ...widget.cromos.map((c) => Container(
            margin: const EdgeInsets.symmetric(vertical: 8, horizontal: 20),
            padding: const EdgeInsets.all(15),
            decoration: BoxDecoration(
              color: turquesaTema.withValues(alpha: 0.2),
              borderRadius: BorderRadius.circular(15),
              border: Border.all(color: turquesaTema, width: 2)
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(Icons.star, color: Colors.amber),
                const SizedBox(width: 10),
                Flexible(child: Text(c, style: const TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.bold), textAlign: TextAlign.center)),
              ],
            ),
          )).toList(),
          const SizedBox(height: 40),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: turquesaTema, padding: const EdgeInsets.symmetric(horizontal: 40, vertical: 15)),
            onPressed: () => Navigator.pop(context),
            child: const Text("GUARDAR EN EL ÁLBUM", style: TextStyle(color: Colors.black, fontWeight: FontWeight.w900, fontSize: 16)),
          )
        ],
      );
    }
  }
}

