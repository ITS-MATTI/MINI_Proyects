// --- SUB-PANTALLA: VER, CREAR Y ASIGNAR SOBRES ---
class _AdminSobresTab extends StatefulWidget {
  const _AdminSobresTab();
  @override State<_AdminSobresTab> createState() => _AdminSobresTabState();
}
class _AdminSobresTabState extends State<_AdminSobresTab> {
  
  // MÉTODO SÚPER RÁPIDO PARA ORDENAR
  int _getNumeroSobre(Map<String, dynamic> data) {
    if (data['numero'] != null) return data['numero'] as int;
    final alias = data['alias']?.toString() ?? '';
    final partes = alias.split(' ');
    if (partes.isNotEmpty) return int.tryParse(partes.last) ?? 999;
    return 999;
  }

  // LOGICA OPTIMIZADA: EL DIALOGO SE ABRE AL INSTANTE
  void _crearSobreLogica(List<QueryDocumentSnapshot> sobresActuales) {
    int maxNum = 0;
    for (var doc in sobresActuales) {
      int n = _getNumeroSobre(doc.data() as Map<String, dynamic>);
      if (n != 999 && n > maxNum) maxNum = n;
    }
    int siguienteNum = maxNum + 1;

    final aliasC = TextEditingController(text: 'Sobre $siguienteNum');
    final contenidoC = TextEditingController();
    String error = '';
    bool guardando = false;
    
    showDialog(context: context, builder: (ctx) => StatefulBuilder(
      builder: (ctx, setM) => AlertDialog(
        backgroundColor: fondoCard, 
        shape: RoundedRectangleBorder(side: const BorderSide(color: verdeNeon, width: 2), borderRadius: BorderRadius.circular(15)),
        title: const Text("Crear Nuevo Sobre", style: TextStyle(color: verdeNeon, fontWeight: FontWeight.w900)),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          TextField(controller: aliasC, style: const TextStyle(color: verdeNeon, fontWeight: FontWeight.bold), decoration: const InputDecoration(labelText: "Alias / Número", labelStyle: TextStyle(color: Colors.white54))),
          const SizedBox(height: 15),
          TextField(controller: contenidoC, maxLines: 3, style: const TextStyle(color: naranjaTema, fontWeight: FontWeight.bold), decoration: const InputDecoration(labelText: "Contenido (separado por comas)", labelStyle: TextStyle(color: Colors.white54), border: OutlineInputBorder())),
          if (error.isNotEmpty) Padding(padding: const EdgeInsets.only(top: 8), child: Text(error, style: const TextStyle(color: Colors.redAccent, fontWeight: FontWeight.bold))),
        ]),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text("CANCELAR", style: TextStyle(color: Colors.grey))),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: verdeNeon), 
            onPressed: guardando ? null : () async {
              if (contenidoC.text.isEmpty) return;
              setM(() => guardando = true);
              final aliasIngresado = aliasC.text.trim();
              
              final check = await FirebaseFirestore.instance.collection('sobres_items').where('alias', isEqualTo: aliasIngresado).get();
              if (check.docs.isNotEmpty) {
                setM(() { error = "Ese nombre o número ya existe."; guardando = false; });
                return;
              }

              // EXTRAER EL NÚMERO PARA GUARDARLO Y OPTIMIZAR EL ORDENAMIENTO FUTURO
              int numeroGuardar = 999;
              final partesAlias = aliasIngresado.split(' ');
              if (partesAlias.isNotEmpty) {
                numeroGuardar = int.tryParse(partesAlias.last) ?? 999;
              }

              List<String> items = contenidoC.text.split(',').map((e) => e.trim()).where((e) => e.isNotEmpty).toList();
              await FirebaseFirestore.instance.collection('sobres_items').add({
                'alias': aliasIngresado,
                'numero': numeroGuardar, // <--- SE GUARDA EL NÚMERO DIRECTO
                'contenido': items,
                'abierto': false,
                'asignado_a': null,
                'fecha_creado': FieldValue.serverTimestamp(),
              });
              if (ctx.mounted) Navigator.pop(ctx);
            }, 
            child: guardando 
              ? const SizedBox(width: 16, height: 16, child: CircularProgressIndicator(color: Colors.black, strokeWidth: 2))
              : const Text("CREAR", style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))
          )
        ],
      )
    ));
  }

  void _mostrarDialogoAsignar(DocumentReference sobreRef, String alias) {
    showDialog(context: context, builder: (ctx) => AlertDialog(
      backgroundColor: fondoCard,
      shape: RoundedRectangleBorder(side: const BorderSide(color: Colors.amber, width: 2), borderRadius: BorderRadius.circular(15)),
      title: Text("Asignar $alias", style: const TextStyle(color: Colors.amber, fontWeight: FontWeight.w900)),
      content: StreamBuilder<QuerySnapshot>(
        stream: FirebaseFirestore.instance.collection('sobres_usuarios').snapshots(),
        builder: (context, snapshot) {
          if (!snapshot.hasData) return const CircularProgressIndicator(color: Colors.amber);
          final users = snapshot.data!.docs;
          if (users.isEmpty) return const Text("Primero debes registrar un usuario en la otra pestaña.", style: TextStyle(color: Colors.white54));
          
          return SizedBox(
            width: double.maxFinite,
            child: ListView.builder(
              shrinkWrap: true,
              itemCount: users.length,
              itemBuilder: (context, i) {
                final uNombre = users[i].id;
                return ListTile(
                  leading: const Icon(Icons.person, color: Colors.amber),
                  title: Text(uNombre, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                  trailing: const Icon(Icons.arrow_forward_ios, color: Colors.amber, size: 14),
                  onTap: () async {
                    await sobreRef.update({'asignado_a': uNombre});
                    if (ctx.mounted) Navigator.pop(ctx);
                  },
                );
              }
            ),
          );
        }
      ),
      actions: [TextButton(onPressed: () => Navigator.pop(ctx), child: const Text("CANCELAR", style: TextStyle(color: Colors.grey)))],
    ));
  }

  void _eliminarTodosSobres(BuildContext context) {
    showDialog(context: context, builder: (ctx) => AlertDialog(
      backgroundColor: fondoCard,
      shape: RoundedRectangleBorder(side: const BorderSide(color: Colors.redAccent), borderRadius: BorderRadius.circular(15)),
      title: const Text("Eliminar Todos", style: TextStyle(color: Colors.redAccent, fontWeight: FontWeight.w900)),
      content: const Text("¿Estás seguro de eliminar a TODOS los sobres? Esta acción no se puede deshacer.", style: TextStyle(color: Colors.white54)),
      actions: [
        TextButton(onPressed: () => Navigator.pop(ctx), child: const Text("CANCELAR", style: TextStyle(color: Colors.grey))),
        ElevatedButton(
          style: ElevatedButton.styleFrom(backgroundColor: Colors.redAccent),
          onPressed: () async {
            final db = FirebaseFirestore.instance;
            final sobres = await db.collection('sobres_items').get();
            final batch = db.batch();
            for(var d in sobres.docs) {
              batch.delete(d.reference);
            }
            await batch.commit();
            if (ctx.mounted) Navigator.pop(ctx);
            if (context.mounted) ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text("Todos los sobres eliminados"), backgroundColor: Colors.redAccent));
          },
          child: const Text("SÍ, ELIMINAR", style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold))
        )
      ]
    ));
  }

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<QuerySnapshot>(
      stream: FirebaseFirestore.instance.collection('sobres_items').snapshots(),
      builder: (context, snapshot) {
        if (!snapshot.hasData) return const Scaffold(body: Center(child: CircularProgressIndicator(color: verdeNeon)));
        final sobres = snapshot.data!.docs;
        
        // ORDENAMIENTO SÚPER RÁPIDO SIN REGEX
        sobres.sort((a, b) {
           final dataA = a.data() as Map<String, dynamic>;
           final dataB = b.data() as Map<String, dynamic>;
           return _getNumeroSobre(dataA).compareTo(_getNumeroSobre(dataB));
        });

        return Scaffold(
          floatingActionButton: FloatingActionButton.extended(
            onPressed: () => _crearSobreLogica(sobres), 
            backgroundColor: verdeNeon, 
            icon: const Icon(Icons.add_box, color: Colors.black), 
            label: const Text("CREAR SOBRE", style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold))
          ),
          body: Column(
            children: [
              if (sobres.isNotEmpty)
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 15, vertical: 10),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Text("Total Sobres: ${sobres.length}", style: const TextStyle(color: Colors.white54, fontWeight: FontWeight.bold)),
                      TextButton.icon(
                        onPressed: () => _eliminarTodosSobres(context), 
                        icon: const Icon(Icons.delete_sweep, color: Colors.redAccent, size: 20), 
                        label: const Text("ELIMINAR TODOS", style: TextStyle(color: Colors.redAccent, fontWeight: FontWeight.bold))
                      )
                    ]
                  ),
                ),
              if (sobres.isEmpty)
                const Expanded(child: Center(child: Text("No has creado ningún sobre aún.", style: TextStyle(color: Colors.white54))))
              else
                Expanded(
                  child: ListView.builder(
                    padding: const EdgeInsets.only(bottom: 80, left: 15, right: 15, top: 10), itemCount: sobres.length,
                    itemBuilder: (context, i) {
                      final s = sobres[i];
                      final data = s.data() as Map<String, dynamic>;
                      final bool abierto = data['abierto'] ?? false;
                      final String? asignadoA = data['asignado_a'];
                      final List<String> cont = List<String>.from(data['contenido'] ?? []);

                      Color cardColor = verdeNeon;
                      String subtitulo = "Libre (Sin asignar)";
                      IconData iconoEstado = Icons.mark_email_unread;

                      if (abierto) {
                        cardColor = Colors.redAccent;
                        subtitulo = "Abierto por ${data['abierto_por'] ?? asignadoA}";
                        iconoEstado = Icons.drafts;
                      } else if (asignadoA != null) {
                        cardColor = Colors.amber;
                        subtitulo = "Asignado a $asignadoA";
                      }

                      return Card(
                        color: Colors.black45, shape: RoundedRectangleBorder(side: BorderSide(color: cardColor), borderRadius: BorderRadius.circular(10)),
                        child: ExpansionTile(
                          leading: Icon(iconoEstado, color: cardColor),
                          title: Text(data['alias'] ?? 'Sobre', style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                          subtitle: Text(subtitulo, style: TextStyle(color: cardColor, fontWeight: FontWeight.w600, fontSize: 12)),
                          trailing: IconButton(icon: const Icon(Icons.delete, color: Colors.grey), onPressed: () => s.reference.delete()),
                          children: [
                            Container(
                              width: double.infinity, padding: const EdgeInsets.all(10), color: Colors.black26,
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text("Contiene:\n${cont.join('\n')}", style: const TextStyle(color: Colors.white70, fontSize: 12)),
                                  const SizedBox(height: 10),
                                  
                                  if (!abierto && asignadoA == null)
                                    ElevatedButton.icon(
                                      style: ElevatedButton.styleFrom(backgroundColor: Colors.amber),
                                      onPressed: () => _mostrarDialogoAsignar(s.reference, data['alias'] ?? 'Sobre'),
                                      icon: const Icon(Icons.person_add, color: Colors.black, size: 16),
                                      label: const Text("ASIGNAR A USUARIO", style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold, fontSize: 12)),
                                    )
                                  else if (!abierto && asignadoA != null)
                                    OutlinedButton.icon(
                                      style: OutlinedButton.styleFrom(side: const BorderSide(color: Colors.amber)),
                                      onPressed: () => s.reference.update({'asignado_a': null}),
                                      icon: const Icon(Icons.person_remove, color: Colors.amber, size: 16),
                                      label: const Text("QUITAR ASIGNACIÓN", style: TextStyle(color: Colors.amber, fontWeight: FontWeight.bold, fontSize: 12)),
                                    )
                                  else if (abierto)
                                    ElevatedButton.icon(
                                      style: ElevatedButton.styleFrom(backgroundColor: verdeNeon),
                                      onPressed: () => s.reference.update({
                                        'abierto': false, 
                                        'abierto_por': null,
                                        'fecha_abierto': null
                                      }),
                                      icon: const Icon(Icons.restore, color: Colors.black, size: 16),
                                      label: const Text("REACTIVAR SOBRE", style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold, fontSize: 12)),
                                    )
                                ],
                              ),
                            )
                          ],
                        ),
                      );
                    },
                  ),
                ),
            ],
          ),
        );
      },
    );
  }
}
