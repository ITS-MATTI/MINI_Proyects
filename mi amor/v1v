// =====================================================================
// PANTALLA 3: EL ROMPECABEZAS Y AUDIO (IMPLEMENTACIÓN REAL Y SINCRONIZADA)
// =====================================================================
class PantallaRompecabezas extends StatefulWidget {
  const PantallaRompecabezas({super.key});

  @override
  State<PantallaRompecabezas> createState() => _PantallaRompecabezasState();
}

class _PantallaRompecabezasState extends State<PantallaRompecabezas> {
  List<int> ordenActual = List.generate(35, (i) => i);
  int? indiceSeleccionado;
  bool resuelto = false;
  bool mostrarSorpresaFinal = false;

  Timer? _timer;
  int _tiempoBase = 60; 
  int _tiempoRestante = 60;
  int _vecesFalladas = 0; 

  // Configuración del Reproductor de Audio
  final AudioPlayer _reproductor = AudioPlayer();
  bool _reproduciendo = false;
  bool _mostrarMensajeDescarga = false; 

  // Variables de Sincronización (Timestamps)
  StreamSubscription? _positionSubscription;
  StreamSubscription? _playerCompleteSubscription;
  
  bool _mostrarAnimacion52 = false; // 0:52 Ella ★
  bool _mostrarAnimacion60 = false; // 1:00 Ella Jenny
  bool _mostrarAnimacion77 = false; // 1:17 Explosión ELLA JENNY<3

  @override
  void initState() {
    super.initState();
    _mezclarEIniciar();

    // ESCUCHAMOS LA POSICIÓN DEL AUDIO EN TIEMPO REAL
    _positionSubscription = _reproductor.onPositionChanged.listen((Duration p) {
      int sec = p.inSeconds;

      // 0:52 por 2 segundos (52 a 53)
      bool show52 = (sec >= 52 && sec < 54);
      // 1:00 por 2 segundos (60 a 61)
      bool show60 = (sec >= 60 && sec < 62);
      // 1:17 por 4-5 segundos (77 a 81)
      bool show77 = (sec >= 77 && sec < 82);

      if (_mostrarAnimacion52 != show52 || _mostrarAnimacion60 != show60 || _mostrarAnimacion77 != show77) {
        setState(() {
          _mostrarAnimacion52 = show52;
          _mostrarAnimacion60 = show60;
          _mostrarAnimacion77 = show77;
        });
      }
    });

    // CUANDO EL AUDIO TERMINA POR COMPLETO
    _playerCompleteSubscription = _reproductor.onPlayerComplete.listen((event) {
      setState(() {
        _reproduciendo = false;
      });
      _mostrarDialogoRepetir();
    });
  }

  void _mostrarDialogoRepetir() {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: colorFondoClaro,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20), side: const BorderSide(color: colorDorado)),
        title: const Text('¡Terminó! 🎶', style: TextStyle(color: colorDorado)),
        content: const Text('La canción ha finalizado. ¿Quieres escucharla otra vez amor?', style: TextStyle(color: colorMarfil, fontSize: 16)),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(ctx);
              // No hacemos nada, solo cerramos
            },
            child: const Text('No, gracias ❤️', style: TextStyle(color: colorRosa, fontSize: 16)),
          ),
          TextButton(
            onPressed: () {
              Navigator.pop(ctx);
              _manejarAudio(); // Vuelve a darle play
            },
            child: const Text('Sí, repetir 🎧', style: TextStyle(color: colorDorado, fontSize: 16, fontWeight: FontWeight.bold)),
          ),
        ]
      )
    );
  }

  void _mezclarEIniciar() {
    setState(() {
      ordenActual.shuffle();
      if (_esVictoria()) {
        ordenActual.shuffle();
      }
      resuelto = false;
      indiceSeleccionado = null;
    });
    _iniciarTimer();
  }

  void _iniciarTimer() {
    _timer?.cancel();
    setState(() { _tiempoRestante = _tiempoBase; });
    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
      setState(() { _tiempoRestante--; });
      if (_tiempoRestante <= 0) {
        _timer?.cancel();
        _tiempoAgotado();
      }
    });
  }

  void _tiempoAgotado() {
    _vecesFalladas++;
    String mensajeAgotado = 'Jajaja, te dije que era contra reloj 🤡 ¡Pero tranquila, inténtalo de nuevo amor!';
    if (_vecesFalladas >= 2) { 
      _tiempoBase = _tiempoBase * 2;
      mensajeAgotado = 'Ya veo que te está costando armarlo amor jajaja 😂\n¡Te voy a dar el doble de tiempo ($_tiempoBase segundos) para que lo logres!';
    }

    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: colorFondoClaro,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20), side: const BorderSide(color: colorDorado)),
        title: const Text('¡Tiempo agotado! ⏰', style: TextStyle(color: colorDorado)),
        content: Text(mensajeAgotado, style: const TextStyle(color: colorMarfil, fontSize: 16)),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(ctx);
              _mezclarEIniciar(); 
            },
            child: const Text('Ok 🙄', style: TextStyle(color: colorRosa, fontSize: 16)),
          )
        ]
      )
    );
  }

  void _tocarPieza(int index) {
    if (resuelto) return;

    setState(() {
      if (indiceSeleccionado == null) {
        indiceSeleccionado = index;
      } else {
        int temp = ordenActual[indiceSeleccionado!];
        ordenActual[indiceSeleccionado!] = ordenActual[index];
        ordenActual[index] = temp;
        indiceSeleccionado = null;
        _verificarVictoria();
      }
    });
  }

  bool _esVictoria() {
    for (int i = 0; i < 35; i++) {
      if (ordenActual[i] != i) return false;
    }
    return true;
  }

  void _verificarVictoria() {
    if (_esVictoria()) {
      _timer?.cancel();
      setState(() { resuelto = true; });
      Future.delayed(const Duration(seconds: 3), () {
        setState(() { mostrarSorpresaFinal = true; });
      });
    }
  }

  void _saltarRompecabezas() {
    _timer?.cancel();
    setState(() {
      ordenActual = List.generate(35, (i) => i);
      resuelto = true;
    });
    Future.delayed(const Duration(milliseconds: 600), () {
      setState(() {
        mostrarSorpresaFinal = true;
      });
    });
  }

  void _manejarAudio() async {
    if (_reproduciendo) {
      await _reproductor.pause();
    } else {
      // Como puede que inicie desde 0 si terminó, forzamos play
      await _reproductor.play(AssetSource('Audio_Dedicada_a_mi_novia.mpeg'));
    }
    setState(() {
      _reproduciendo = !_reproduciendo;
    });
  }

  void _simularDescarga() {
    setState(() {
      _mostrarMensajeDescarga = true;
    });
    Future.delayed(const Duration(seconds: 3), () {
      if (mounted) {
        setState(() {
          _mostrarMensajeDescarga = false;
        });
      }
    });

    // LÓGICA DE DESCARGA REAL USANDO DART:HTML
    try {
      final anchor = html.AnchorElement(href: 'assets/assets/Audio_Dedicada_a_mi_novia.mpeg');
      anchor.download = 'Audio_Dedicada_a_mi_novia.mpeg';
      anchor.click();
    } catch (e) {
      // En caso de que haya algún bloqueo del navegador, lo silencia para no crashear
      debugPrint("Error de descarga: $e");
    }
  }

  @override
  void dispose() {
    _timer?.cancel();
    _positionSubscription?.cancel();
    _playerCompleteSubscription?.cancel();
    _reproductor.dispose(); 
    super.dispose();
  }

  Widget _crearPieza(int indiceCorrecto, double anchoPieza, double altoPieza) {
    int col = indiceCorrecto % 5;
    int row = indiceCorrecto ~/ 5;

    double x = -1.0 + (col * (2.0 / 4));
    double y = -1.0 + (row * (2.0 / 6));

    return ClipRect(
      child: SizedBox(
        width: anchoPieza,
        height: altoPieza,
        child: OverflowBox(
          maxWidth: anchoPieza * 5,
          maxHeight: altoPieza * 7,
          alignment: Alignment(x, y),
          child: Image.asset(
            'assets/IMG-20230426-WA0085.jpg',
            fit: BoxFit.cover,
          ),
        ),
      ),
    );
  }

