                                          : _crearPieza(indiceImagen, anchoPieza, altoPieza),
                                    ),
                                  );
                                },
                              ),
                            ),
                            
                            const SizedBox(height: 20),
                            TextButton(
                              onPressed: _saltarRompecabezas,
                              child: const Text(
                                'Saltar rompecabezas (Solo para pruebas)',
                                style: TextStyle(color: colorRosa, decoration: TextDecoration.underline),
                              ),
                            ),
                          ],

                          if (mostrarSorpresaFinal) ...[
                            Container(
                              margin: const EdgeInsets.symmetric(horizontal: 24),
                              padding: const EdgeInsets.all(25),
                              decoration: BoxDecoration(
                                color: Colors.white.withValues(alpha: 0.05),
                                borderRadius: BorderRadius.circular(18),
                                border: Border.all(color: colorDorado.withValues(alpha: 0.3), style: BorderStyle.solid),
                              ),
                              child: Column(
                                children: [
                                  const Text(
                                    '¿Última sorpresa?',
                                    style: TextStyle(fontSize: 26, fontWeight: FontWeight.bold, color: colorDorado),
                                  ),
                                  const SizedBox(height: 20),
                                  const Text(
                                    'Como te dediqué la canción de BEMASTE - Tiago PZK, ahora este nuevo que es un adelanto.\n\nEntonces, hasta que salga, te lo dedico jsjs ❤️',
                                    textAlign: TextAlign.center,
                                    style: TextStyle(fontSize: 16, color: colorMarfil, height: 1.5),
                                  ),
                                  const SizedBox(height: 10),
                                  const Text(
