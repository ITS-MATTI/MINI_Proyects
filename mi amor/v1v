class PantallaValidacion extends StatefulWidget {
  const PantallaValidacion({super.key});

  @override
  State<PantallaValidacion> createState() => _PantallaValidacionState();
}

class _PantallaValidacionState extends State<PantallaValidacion> {
  final TextEditingController _respuestaController = TextEditingController();
  
  int _pasoActual = 0;
  int _intentosFallidos = 0;
  
  Timer? _timerPregunta;
  int _tiempoPregunta = 20;
  bool _segundoIntentoHora = false;

  @override
  void dispose() {
    _timerPregunta?.cancel();
    super.dispose();
  }

  String getPreguntaActual() {
    switch (_pasoActual) {
      case 0: return '¿Me amas mucho o poco?';
      case 1: return 'Nivel 2...\n¿Cómo se llama la futura enfermera más hermosa de todas?';
      case 2: return '¿Cuando fue que te dije por primera vez TE AMO?\n(NO BUSQUES EN WHATSAPP)';
      case 3: return '¡Rápido!\n¿A qué hora exacta fue? 👀';
      case 4: return 'Y ahora...\n¿Cuando fue la primera vez que TÚ me dijiste te amo?';
      default: return '';
    }
  }

  void _iniciarTimerPregunta() {
    _tiempoPregunta = 20;
    _timerPregunta = Timer.periodic(const Duration(seconds: 1), (timer) {
      setState(() {
        _tiempoPregunta--;
        if (_tiempoPregunta <= 0) {
          timer.cancel();
          _manejarFalloHora();
        }
      });
    });
  }

  void _manejarFalloHora() {
    _timerPregunta?.cancel();
    
    if (_segundoIntentoHora) {
      setState(() {
        _pasoActual = 4;
        _respuestaController.clear();
      });
    } else {
      showDialog(
        context: context,
        barrierDismissible: false,
        builder: (ctx) => AlertDialog(
          backgroundColor: colorFondoClaro,
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20), side: const BorderSide(color: colorDorado)),
          title: const Text('Uy...', style: TextStyle(color: colorDorado)),
          content: const Text(
            'Ya nada jaja solo por ser pana pasa nomas aun que perdiste algo jaja o quieres un ultimo intento? o la siguiente pregunta', 
            style: TextStyle(color: colorMarfil, fontSize: 16)
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(ctx);
                setState(() {
                  _segundoIntentoHora = true;
                  _respuestaController.clear();
                  _iniciarTimerPregunta();
                });
              },
              child: const Text('Último intento', style: TextStyle(color: colorDorado)),
            ),
            TextButton(
              onPressed: () {
                Navigator.pop(ctx);
                setState(() {
                  _pasoActual = 4;
                  _respuestaController.clear();
                });
              },
              child: const Text('Siguiente pregunta', style: TextStyle(color: colorRosa)),
            )
          ],
        )
      );
    }
  }

  void _mostrarAlertaSimple(String mensaje) {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: colorFondoClaro,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20), side: const BorderSide(color: colorDorado)),
        title: const Text('Oye...', style: TextStyle(color: colorDorado)),
        content: Text(mensaje, style: const TextStyle(fontSize: 16, color: colorMarfil)),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('Ok 🙄', style: TextStyle(color: colorRosa, fontSize: 16)),
          ),
        ],
      )
    );
  }

  void _mostrarAlertaConAccion(String mensaje, VoidCallback accion) {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: colorFondoClaro,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20), side: const BorderSide(color: colorDorado)),
        title: const Text('¡Atención!', style: TextStyle(color: colorDorado)),
        content: Text(mensaje, style: const TextStyle(fontSize: 16, color: colorMarfil, height: 1.4)),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(ctx);
              accion();
            },
            child: const Text('Entendido ❤️', style: TextStyle(color: colorRosa, fontSize: 16)),
          ),
        ],
      )
    );
  }

  void _validarRespuesta() {
    String txtOriginal = _respuestaController.text.trim().toLowerCase();
    if (txtOriginal.isEmpty) return;

    String txtLimpio = txtOriginal.replaceAll(' ', '');

    if (_pasoActual == 0) {
      if (['demasiado', 'muchísimo', 'muchisimo'].contains(txtLimpio)) {
        setState(() { _pasoActual = 1; _intentosFallidos = 0; _respuestaController.clear(); });
      } else if (txtLimpio == 'bastante' || txtLimpio == 'bastante?') {
        _mostrarAlertaSimple('uuuu si te tengo que decir que chiste y por que solo bastante y no demasiado :c, ajja');
      } else {
        _intentosFallidos++;
        if (_intentosFallidos == 1) _mostrarAlertaSimple('¿Por qué no bastante? 🤨');
        else if (_intentosFallidos == 2) _mostrarAlertaSimple('Si te digo así, ¿qué chiste? jajaja 🤡');
        else _mostrarAlertaSimple('Ya pon "demasiado" amor, hazlo por mí jajaja ❤️');
      }
    } 
    else if (_pasoActual == 1) {
      if (['jenny', 'yo'].contains(txtLimpio)) {
        setState(() { _pasoActual = 2; _intentosFallidos = 0; _respuestaController.clear(); });
      } else {
        _intentosFallidos++;
        if (_intentosFallidos == 1) _mostrarAlertaSimple('Esa no es... intenta de nuevo.');
        else if (_intentosFallidos == 2) _mostrarAlertaSimple('Empieza con J y termina con enny ❤️');
        else _mostrarAlertaSimple('Ay amor, eres tú jajaja pon tu nombre.');
      }
    }
    else if (_pasoActual == 2) {
      if (txtLimpio == '21/mayo/2023' || txtLimpio == '21/05/2023') {
        setState(() { 
          _pasoActual = 3; 
          _intentosFallidos = 0; 
          _respuestaController.clear(); 
        });
        _iniciarTimerPregunta(); 
      } else {
        _intentosFallidos++;
        if (_intentosFallidos == 1) _mostrarAlertaSimple('Uy... piensa bien. Sin ver WhatsApp 👀');
        else if (_intentosFallidos == 2) _mostrarAlertaSimple('Revisa tu memoria. Fue a finales de mayo...');
        else _mostrarAlertaSimple('Vamos, tiene este formato: 21/05/2023 o 21/mayo/2023 🥺');
      }
    }
    else if (_pasoActual == 3) {
      if (txtLimpio == '6:27pm' || txtLimpio == '18:27' || txtLimpio == '6:27') {
        _timerPregunta?.cancel();
        _mostrarAlertaConAccion(
          ':0 me sorprendeiste (aun que sacaste de whatsapp por la anterior pregunta)\n\nSaca captura de pantalla y cuando me enoje y quieres que se me quite el enoje sin escusa me muestras esta captura de pantalla\n\n(Válido hasta este año y solo 1 vez)', 
          () {
            setState(() { _pasoActual = 4; _respuestaController.clear(); });
          }
        );
      } else {
        _manejarFalloHora();
      }
    }
    else if (_pasoActual == 4) {
      if (txtLimpio == '22/mayo/2023' || txtLimpio == '22/05/2023') {
        _mostrarAlertaConAccion('Osea legalmente fue el 23 pero te la compro 😏', () {
          Navigator.pushReplacement(context, MaterialPageRoute(builder: (context) => const PantallaRompecabezas()));
        });
      } else if (txtLimpio == '23/mayo/2023' || txtLimpio == '23/05/2023') {
        _mostrarAlertaConAccion('Muy bien, igual me dijiste indirectamente que me amabas el 22 pero aja xd ❤️', () {
          Navigator.pushReplacement(context, MaterialPageRoute(builder: (context) => const PantallaRompecabezas()));
        });
      } else {
        _intentosFallidos++;
        if (_intentosFallidos == 1) _mostrarAlertaSimple('¿Segura? Fue justo al día siguiente o dos días después de que yo te lo dije...');
        else _mostrarAlertaSimple('Pon la fecha en formato: 22/05/2023 o 23/mayo/2023 🥺');
      }
    }
  }

  void _saltarPregunta() {
    if (_pasoActual < 4) {
      setState(() {
        _pasoActual++;
        _intentosFallidos = 0;
        _respuestaController.clear();
      });
      if (_pasoActual == 3) {
        _iniciarTimerPregunta();
      } else {
        _timerPregunta?.cancel();
      }
    } else {
      _timerPregunta?.cancel();
      Navigator.pushReplacement(context, MaterialPageRoute(builder: (context) => const PantallaRompecabezas()));
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Stack(
        children: [
          const CorazonesFlotantes(),
          SafeArea(
            child: Column(
              children: [
                const BarraPestanas(nivelActivo: 1),
                Expanded(
                  child: Center(
                    child: SingleChildScrollView(
                      padding: const EdgeInsets.all(24.0),
                      child: Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          Text(
                            'Prueba ${_pasoActual + 1} de 5',
                            style: const TextStyle(fontSize: 14, color: colorRosa, letterSpacing: 2),
                          ),
                          const SizedBox(height: 20),
                          
                          if (_pasoActual == 3) ...[
                            Text(
                              '00:${_tiempoPregunta.toString().padLeft(2, '0')}',
                              style: TextStyle(fontSize: 36, fontWeight: FontWeight.bold, color: Colors.red[600], letterSpacing: 2),
                            ),
                            const SizedBox(height: 10),
                          ],

                          Text(
                            getPreguntaActual(),
                            textAlign: TextAlign.center,
                            style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold, color: colorMarfil, height: 1.3),
                          ),
                          const SizedBox(height: 40),
                          
                          TextField(
                            controller: _respuestaController,
                            textAlign: TextAlign.center,
                            style: const TextStyle(color: colorMarfil, fontSize: 18),
                            decoration: InputDecoration(
                              hintText: 'Tu respuesta...',
