                                style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold, color: colorDorado, height: 1.4),
                              ),
                              const SizedBox(height: 20),
                            ],
                            
                            Container(
                              width: anchoTablero,
                              height: altoTablero,
                              decoration: BoxDecoration(
                                color: colorFondo,
                                border: Border.all(color: colorDorado, width: resuelto ? 4 : 2),
                                boxShadow: [
                                  BoxShadow(color: Colors.black.withValues(alpha: 0.6), blurRadius: 15, spreadRadius: 2)
                                ],
                              ),
                              child: GridView.builder(
                                physics: const NeverScrollableScrollPhysics(),
                                gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                                  crossAxisCount: 5,
                                  childAspectRatio: anchoPieza / altoPieza,
                                  crossAxisSpacing: resuelto ? 0 : 1.5,
                                  mainAxisSpacing: resuelto ? 0 : 1.5,
                                ),
                                itemCount: 35,
                                itemBuilder: (context, index) {
                                  int indiceImagen = ordenActual[index];
