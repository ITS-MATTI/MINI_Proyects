class LluviaDeNombres extends StatefulWidget {
  const LluviaDeNombres({super.key});

  @override
  State<LluviaDeNombres> createState() => _LluviaDeNombresState();
}

class _LluviaDeNombresState extends State<LluviaDeNombres> with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  final math.Random _random = math.Random();
  late List<double> _x;
  late List<double> _y;
  late List<double> _sizes;
  late List<bool> _isElla;

  @override
  void initState() {
    super.initState();
    // Animación de parpadeo rápido
    _controller = AnimationController(vsync: this, duration: const Duration(milliseconds: 400))..repeat(reverse: true);
    _x = List.generate(35, (i) => _random.nextDouble());
    _y = List.generate(35, (i) => _random.nextDouble());
    _sizes = List.generate(35, (i) => 20 + _random.nextDouble() * 30);
    _isElla = List.generate(35, (i) => i % 2 == 0);
  }

  @override
  void dispose() { 
    _controller.dispose(); 
    super.dispose(); 
  }

  @override
  Widget build(BuildContext context) {
    return IgnorePointer(
      child: AnimatedBuilder(
        animation: _controller,
        builder: (context, child) {
          double width = MediaQuery.of(context).size.width;
          double height = MediaQuery.of(context).size.height;
          return Stack(
            children: List.generate(35, (i) {
              return Positioned(
                left: _x[i] * (width - 100),
                top: _y[i] * (height - 50),
                child: Transform.scale(
                  scale: 0.8 + (_controller.value * 0.4),
                  child: Text(
                    _isElla[i] ? 'ELLA' : 'JENNY <3',
                    style: TextStyle(
                      color: _isElla[i] ? colorRosa : colorDorado,
                      fontWeight: FontWeight.bold,
                      fontSize: _sizes[i],
                      shadows: const [Shadow(color: Colors.black, blurRadius: 8)],
                    )
                  )
                )
              );
            })
          );
        }
      ),
    );
  }
}

