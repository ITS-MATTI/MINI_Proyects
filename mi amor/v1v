// ANIMACIÓN 1: CORAZONES FLOTANTES DE FONDO
// =====================================================================
class CorazonesFlotantes extends StatefulWidget {
  const CorazonesFlotantes({super.key});

  @override
  State<CorazonesFlotantes> createState() => _CorazonesFlotantesState();
}

class _CorazonesFlotantesState extends State<CorazonesFlotantes> with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  final math.Random _random = math.Random();
  late List<double> _offsetsX;
  late List<double> _offsetsY;
  late List<double> _sizes;
  late List<bool> _isLeft;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(vsync: this, duration: const Duration(seconds: 8))..repeat();
    _offsetsX = List.generate(16, (i) => _random.nextDouble() * 60);
    _offsetsY = List.generate(16, (i) => _random.nextDouble());
    _sizes = List.generate(16, (i) => 15 + _random.nextDouble() * 25);
    _isLeft = List.generate(16, (i) => i % 2 == 0);
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _controller,
      builder: (context, child) {
        double height = MediaQuery.of(context).size.height;
        double width = MediaQuery.of(context).size.width;

        return Stack(
          children: List.generate(16, (i) {
            double progress = (_controller.value + _offsetsY[i]) % 1.0;
            double yPos = height - (progress * (height + 150)); 
            double onda = math.sin(progress * math.pi * 6) * 15;
            double xPos = _isLeft[i] 
                ? _offsetsX[i] + onda 
                : (width - _offsetsX[i] - _sizes[i]) + onda;

            return Positioned(
              left: xPos,
              top: yPos,
              child: Opacity(
                opacity: math.max(0.0, 1.0 - progress),
                child: Icon(
                  Icons.favorite, 
                  color: colorRosa.withValues(alpha: 0.15), 
                  size: _sizes[i]
                ),
              ),
            );
          }),
        );
      },
    );
  }
}

// =====================================================================
// ANIMACIÓN 2: "TE AMO" EN BLANCO TRANSLÚCIDO
// =====================================================================
class AmorFlotante extends StatefulWidget {
  const AmorFlotante({super.key});

  @override
  State<AmorFlotante> createState() => _AmorFlotanteState();
}

class _AmorFlotanteState extends State<AmorFlotante> with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  final math.Random _random = math.Random();
  late List<double> _offsetsX;
  late List<double> _offsetsY;
  late List<double> _sizes;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(vsync: this, duration: const Duration(seconds: 6))..repeat();
    _offsetsX = List.generate(20, (i) => _random.nextDouble());
    _offsetsY = List.generate(20, (i) => _random.nextDouble());
    _sizes = List.generate(20, (i) => 25 + _random.nextDouble() * 20); 
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return IgnorePointer( 
      child: AnimatedBuilder(
        animation: _controller,
        builder: (context, child) {
          double height = MediaQuery.of(context).size.height;
          double width = MediaQuery.of(context).size.width;

          return Stack(
            children: List.generate(20, (i) {
              double progress = (_controller.value + _offsetsY[i]) % 1.0;
              double yPos = height - (progress * (height + 150)); 
              double onda = math.sin(progress * math.pi * 4) * 30;
              double xPos = (_offsetsX[i] * width) + onda;

              if (xPos < 0) xPos = 0;
              if (xPos > width - 60) xPos = width - 60;

              return Positioned(
                left: xPos,
                top: yPos,
                child: Opacity(
                  opacity: math.max(0.0, 1.0 - progress),
                  child: Text(
                    'Te amo', 
                    style: TextStyle(
                      color: Colors.white.withValues(alpha: 0.8),
                      fontSize: _sizes[i] * 0.8, 
                      fontWeight: FontWeight.bold,
                      fontStyle: FontStyle.italic,
                      shadows: [
                        Shadow(color: Colors.black.withValues(alpha: 0.5), blurRadius: 4, offset: const Offset(1, 1))
                      ]
                    )
                  ),
                ),
              );
            }),
          );
        },
      ),
    );
  }
}

