                              ),
                              const SizedBox(height: 5),
                              Text(
                                '${(_tiempoRestante ~/ 60).toString().padLeft(2, '0')}:${(_tiempoRestante % 60).toString().padLeft(2, '0')}',
                                style: const TextStyle(fontSize: 40, fontWeight: FontWeight.bold, color: colorDorado, letterSpacing: 2),
                              ),
                              const SizedBox(height: 15),
                            ] else ...[
                              const Text(
                                'Para ti 💛\nSolo por bonita.\nTe amo, mi princesa.',
